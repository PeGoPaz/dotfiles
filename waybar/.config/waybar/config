{
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "mpris",
        "group/stats",
        "wireplumber",
        "network",
        "bluetooth",
        "battery",
        "group/tray-group",
        "clock"
    ],
    "group/tray-group": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false
        },
        "modules": [
            "custom/tray-icon",
            "tray"
        ]
    },
    "custom/tray-icon": {
        "format": "󰀻",
        "tooltip": false
    },
    "tray": {
        "icon-size": 16,
        "spacing": 10
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{name}"
    },
    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },
    "mpris": {
        "format": "{title}",
        "max-length": 20,
        "ellipsis": "..."
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "temperature",
            "memory"
        ]
    },
    "cpu": {
        "interval": 5,
        "format": "󰻠 {usage}%",
        "tooltip": false
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 95,
        "interval": 5,
        "format": "{temperatureC}°",
        "tooltip-format": "CPU {temperatureC}°C"
    },
    "memory": {
        "interval": 10,
        "format": "{percentage}%",
        "tooltip-format": "RAM {used:0.1f} / {total:0.1f} GiB"
    },
    "bluetooth": {
        "format": "",
        "format-on": "",
        "format-off": "",
        "format-disabled": "",
        "format-no-controller": "",
        "format-connected": "󰂱",
        "tooltip-format-connected": "{device_enumerate}",
        "on-click": "ghostty -e bluetoothctl"
    },
    "wireplumber": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "ghostty -e nmtui"
    },
    "battery": {
        "states": {
            "critical": 12
        },
        "format": "{capacity}%",
        "tooltip-format": "{time} ({capacity}%)"
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "locale": "en_IE.UTF-8",
        "tooltip-format": "<big>{:%d/%m/%Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month"
        }
    }
}

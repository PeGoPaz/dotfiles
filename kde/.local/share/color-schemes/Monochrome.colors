# Monochrome: bg #0f0f0f, surface #1a1a1a, border #2a2a2a, muted #6e6e6e,
# text #e6e6e6. Accent #c678dd marks focus and selection only. #ff6b6b is for
# errors only.
#
# Stowed into ~/.local/share/color-schemes, where Dolphin finds it by the id
# "Monochrome" (the file name). apply-colours.sh copies the same groups into
# kdeglobals, which KDE programs rewrite and which is therefore not stowed.

[General]
ColorScheme=Monochrome
Name=Monochrome

[KDE]
contrast=4

# KDE has no colour for disabled text, only effects. Fading the text 0.56 of
# the way towards a #0f0f0f background lands exactly on #6e6e6e; on a #1a1a1a
# button it comes out as #747474.
[ColorEffects:Disabled]
Color=15,15,15
ColorAmount=0
ColorEffect=0
ContrastAmount=0.56
ContrastEffect=1
IntensityAmount=0
IntensityEffect=0

# Unfocused windows look the same as focused ones.
[ColorEffects:Inactive]
ChangeSelectionColor=false
Color=15,15,15
ColorAmount=0
ColorEffect=0
ContrastAmount=0
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=42,42,42
BackgroundNormal=26,26,26
DecorationFocus=198,120,221
DecorationHover=110,110,110
ForegroundActive=230,230,230
ForegroundInactive=110,110,110
ForegroundLink=230,230,230
ForegroundNegative=255,107,107
ForegroundNeutral=110,110,110
ForegroundNormal=230,230,230
ForegroundPositive=230,230,230
ForegroundVisited=110,110,110

